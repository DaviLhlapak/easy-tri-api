# Neon Postgres connection string
# https://neon.tech -> Project -> Connection Details
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/dbname?sslmode=require

# Secret used to sign session JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-me

# OTP delivery adapter: "mock" (default, logs the code and returns it in the
# response) or "twilio" (sends a real SMS, never returns the code).
OTP_DELIVERY_DRIVER=mock

# Required when OTP_DELIVERY_DRIVER=twilio
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Messaging Service SID (preferred) or a from-number in E.164:
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Country code used to convert stored local phone numbers to E.164 (default "55" = Brazil)
TWILIO_DEFAULT_COUNTRY_CODE=55

# Channel to send the OTP through: "sms" (default) or "whatsapp".
TWILIO_CHANNEL=sms

# Only used when TWILIO_CHANNEL=whatsapp. Business-initiated WhatsApp
# messages (like an OTP) generally require an approved Content Template
# instead of free-form text - set this to that template's Content SID.
# TWILIO_CONTENT_VARIABLE_NAME defaults to "1" (Twilio's usual placeholder name).
TWILIO_CONTENT_SID=
TWILIO_CONTENT_VARIABLE_NAME=1
